# Direct Azure OpenAI resource endpoint used for embeddings and chat.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com

# Azure OpenAI deployment names.
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
CHAT_MODEL_DEPLOYMENT=gpt-4o

# Azure AI Search endpoint and index.
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=ai103-study-index

